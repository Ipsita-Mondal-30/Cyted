# Supabase (Auth + Postgres)
# If your password contains @ # etc, URL-encode it (e.g. @ -> %40)
# DATABASE_URL = transaction pooler (6543) for the app
# DIRECT_URL   = session/direct (5432) for prisma db push / migrate
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Redis / Upstash (BullMQ)
# MUST be rediss:// (TLS) for Upstash — redis:// causes ECONNRESET/EPIPE loops.
# Copy from Upstash console → Connect → Node.js (ioredis) — use the TLS URL.
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_ENDPOINT.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://YOUR_ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# LLM Providers (enable a provider by setting its key)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.0-flash
CLAUDE_MODEL=claude-sonnet-4-20250514

# Prompt generation
PROMPTS_PER_CATEGORY=2
PROMPT_CATEGORIES=Comparison,Buying,Pricing,Reviews,Features,Alternatives

# Worker concurrency & retries
# Search fans out across providers in parallel (faster on Render).
CONCURRENT_REQUESTS=8
# Optional overrides:
# SEARCH_CONCURRENCY=10
# EXTRACT_CONCURRENCY=6
# Concurrent calls per provider (OpenAI/Gemini/Claude each get their own pool)
PER_PROVIDER_CONCURRENCY=3
MAX_RETRIES=2

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
